<div class="modal fade" id="practiceInfo" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">{{practice.name}}</h5>
                <button type="button" v-on:click="hidePracticeInfo" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div>
                    <img v-bind:src="practice.logoUrl" v-bind:alt="practice.name" id="practiceLogo" onerror="this.onerror=null; this.src='../assets/images/practicePlaceHolder.jpg'" />
                    <h5 class="card-title">{{practice.address}}</h5>
                    <h6>{{practice.postal}} {{practice.city}}</h6>
                    <div class="card-text">
                        <b>Opening Hours:</b> {{ practice.openTime | formatTime() }} - {{ practice.closeTime | formatTime() }}
                        <br />
                        <b>E-mail:</b> {{practice.email}}
                        <br />
                        <b>Phone:</b> {{practice.phone}}
                    </div>
                </div>
                <div class="mt-4">
                    <h5 class="card-title  mb-0">Veterinarians:</h5>
                    <span v-for="vet in practice.veterinarianIds">{{vet.firstName}} {{vet.lastName}}<br /></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="showUpdatePracticeForm" v-if="isPractice" class="btn btn-warning">Update</button>
                <button type="button" v-on:click.prevent="deletePractice(practice.id)" v-if="isVet && isPractice" class="btn btn-danger">Delete</button>
                <button type="button" v-on:click="hidePracticeInfo" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addPracticeForm" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Add Practice</h5>
                <button type="button" v-on:click="hideAddPracticeForm" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div v-if="hasInputError" class="alert alert-danger m-auto" id="formError">
                    {{errorMessage}}
                </div>
                <form>
                    <div class="form-group">
                        <label>Name:</label>
                        <input v-model="practice.name" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>E-mail:</label>
                        <input v-model="practice.email" type="email" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Phone:</label>
                        <input v-model="practice.phone" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Address:</label>
                        <input v-model="practice.address" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>City:</label>
                        <input v-model="practice.city" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Postal:</label>
                        <input v-model="practice.postal" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Opening time:</label>
                        <input v-model="practice.openTime" type="time" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Closing time:</label>
                        <input v-model="practice.closeTime" type="time" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Veterinarians:</label>
                        <select v-model="practice.veterinarianIds" multiple>
                            <option v-for="vet in veterinarians" :value="vet.id">
                                {{ vet.firstName }} - {{ vet.lastName }}
                            </option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Logo:</label>
                        <input v-on:change="handleFileChange" type="file" class="form-control" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="hideAddPracticeForm" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" v-on:click="addPractice" v-if="!isUpdate" class="btn btn-primary">Add Practice</button>
                <button type="button" v-on:click="updatePractice" v-if="isUpdate" class="btn btn-primary">Update Practice</button>
            </div>
        </div>
    </div>
</div>