<div class="modal fade" id="consultationInfo" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">{{consultation.title}}</h5>
                <button type="button" v-on:click="hideConsultationInfo" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div>
                    <p><b>Pet:</b> {{consultation.petName}}</p>
                    <p><b>Diagnose:</b> {{consultation.diagnosis}}</p>
                    <p><b>Treatment:</b> {{consultation.treatment}}</p>
                    <p><b>Note:</b> {{consultation.notes}}</p>
                    <p><b>Date:</b> {{consultation.dateOfConsultation | formatDate() }}</p>
                    <span><b>Image: </b> {{ consultation.image }} </span><br />
                    <span><b>Document: </b> {{ consultation.document }} </span><br />
                    <p><b>Veterinarian:</b> {{ consultation.veterinarianName }}</p>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="showUpdateConsultationForm" v-if="isVet" class="btn btn-warning">Update</button>
                <button type="button" v-on:click.prevent="deleteConsultation(consultation.id)" v-if="isVet" class="btn btn-danger">Delete</button>
                <button type="button" v-on:click="hideConsultationInfo" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addConsultationForm" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Consultation</h5>
                <button type="button" v-on:click="hideConsultationForm" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div v-if="hasInputError" class="alert alert-danger m-auto" id="formError">
                    {{errorMessage}}
                </div>
                <form>

                    <div class="row">
                        <div class="form-group col">
                            <label class="col-form-label">Title:</label>
                            <input v-model="consultation.title" type="text" class="form-control" />
                        </div>
                        <div class="form-group col">
                            <label class="col-form-label">Date of consultation:</label>
                            <input v-model="consultation.dateOfConsultation" type="datetime-local" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-form-label">Diagnose:</label>
                        <textarea v-model="consultation.diagnosis" type="" class="form-control" ></textarea>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Treatment:</label>
                        <textarea v-model="consultation.treatment" type="text" class="form-control" ></textarea>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Notes:</label>
                        <textarea v-model="consultation.notes" type="text" class="form-control" ></textarea>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Veterinarian:</label>
                        <select class="form-select" name="Veterinarian" v-model="veterinarian.id">
                            <option v-for="vet in veterinarians" :value="vet.id">{{vet.firstName}} {{vet.lastName}}</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Pet:</label>
                        <select class="form-select" name="Pet" v-model="pet.id">
                            <option v-for="pet in pets" :value="pet.id">{{pet.name}}</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="col-form-label">Image:</label>
                        <input v-on:change="handleConsultImageChange" id="fileUploadConsultImg" type="file" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label class="col-form-label">Document:</label>
                        <input v-on:change="handleConsultDocChange" id="fileUploadConsultDoc" type="file" class="form-control" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="hideConsultationForm" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" v-on:click="addConsultation" v-if="!isUpdate" class="btn btn-primary">Add Consultation</button>
                <button type="button" v-on:click="updateConsultation" v-if="isUpdate" class="btn btn-primary">Update Consultation</button>
            </div>
        </div>
    </div>
</div>