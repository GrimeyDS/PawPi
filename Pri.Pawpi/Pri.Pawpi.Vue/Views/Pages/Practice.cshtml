<div v-if="practicesVisible" class="row">

    <div class="col col-lg-8 m-auto">
        <div class="text-center">
            <input type="text" v-model="searchVeterinarianName" v-on:keyup="searchVeterinarianByName" placeholder="Search by name" />
        </div>


        <div v-for="practice in practices" >
            <div class="card m-3">
                <h5 class="card-header">{{practice.name}}</h5>
                <div class="card-body">
                    <img v-bind:src="practice.logoUrl" v-bind:alt="practice.name" id="practiceLogo" onerror="this.onerror=null; this.src='https://www.dierenklinieksoest.nl/Portals/0/adam/Content/k2XQQ4GgQE21KP45ShsjyQ/Photo/dierenarts-logo.jpg?w=379&h=488&mode=crop&quality=90'" />
                    <h5 class="card-title">{{practice.address}}</h5>
                    <h6>{{practice.postal}} {{practice.city}}</h6>
                    <p class="card-text">Opening hours: {{ practice.openTime | formatTime() }} - {{ practice.closeTime | formatTime() }}</p>
                    <a href="#" v-on:click="showPracticeInfo(practice.id)" class="btn btn-primary">See details</a>
                </div>
            </div>
        </div>
    </div>
</div>