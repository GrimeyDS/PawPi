<div class="modal fade" id="customerInfo" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">{{customer.firstName}} {{customer.lastName}}</h5>
                <button type="button" v-on:click="hideCustomerInfo" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div>
                    <h5 class="card-title">{{customer.address}}</h5>
                    <h6>{{customer.postal}} {{customer.city}}</h6>
                    <div class="card-text">
                        <b>Birthdate:</b> {{ customer.birth | formatDate() }}
                        <br />
                        <b>E-mail:</b> {{customer.email}}
                        <br />
                        <b>Phone:</b> {{customer.phone}}
                    </div>
                </div>
                <div class="mt-4">
                    <h5 class="card-title  mb-0">Practice:</h5>
                    <span>{{practice.name}}</span>
                    <h5 class="card-title  mb-0">Pets:</h5>
                    <span v-for="pet in customer.pets">{{pet.name}}<br /></span>
                    <br />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="showUpdateCustomerForm" v-if="isVet || isPractice" class="btn btn-warning">Update</button>
                <button type="button" v-on:click.prevent="deleteCustomer(customer.id)" v-if="isVet || isPractice" class="btn btn-danger">Delete</button>
                <button type="button" v-on:click="hideCustomerInfo" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addCustomerForm" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Customer</h5>
                <button type="button" v-on:click="hideCustomerForm" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div v-if="hasInputError" class="alert alert-danger m-auto" id="formError">
                    {{errorMessage}}
                </div>
                <form>

                    <div class="row">
                        <div class="form-group col">
                            <label class="col-form-label">First name:</label>
                            <input v-model="customer.firstName" type="text" class="form-control" />
                        </div>
                        <div class="form-group col">
                            <label class="col-form-label">Last name:</label>
                            <input v-model="customer.lastName" type="text" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group col">
                        <label class="col-form-label">E-mail:</label>
                        <input v-model="customer.email" type="email" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="form-group col">
                            <label class="col-form-label">Phone:</label>
                            <input v-model="customer.phone" type="tel" class="form-control" />
                        </div>
                        <div class="form-group col">
                            <label class="col-form-label">Birthday:</label>
                            <input v-model="customer.birth" type="datetime-local" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group col">
                        <label class="col-form-label">Address:</label>
                        <input v-model="customer.address" type="text" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="form-group col">
                            <label class="col-form-label">City:</label>
                            <input v-model="customer.city" type="text" class="form-control" />
                        </div>
                        <div class="form-group col">
                            <label class="col-form-label">Postal:</label>
                            <input v-model="customer.postal" type="text" class="form-control" />
                        </div>
                    </div>


                    <div class="form-group col">
                        <label class="col-form-label">Practice:</label>
                        <select class="form-select" name="Practice" v-model="practice.id">
                            <option v-for="practice in practices" :value="practice.id">{{practice.name}}</option>
                        </select>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="hideCustomerForm" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" v-on:click="addCustomer" v-if="!isUpdate" class="btn btn-primary">Add Customer</button>
                <button type="button" v-on:click="updateCustomer" v-if="isUpdate" class="btn btn-primary">Update Customer</button>
            </div>
        </div>
    </div>
</div>