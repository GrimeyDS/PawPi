<div class="modal fade" id="registerCustomerForm" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Registration:</h5>
                <button type="button" v-on:click="hideRegisterForm" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div v-if="hasInputError" class="alert alert-danger m-auto" id="formError">
                    {{errorMessage}}
                </div>
                <form>
                    <div class="form-group">
                        <label class="form-group">E-mail:</label>
                        <input v-model="registerCustomerDto.email" type="email" class="form-control"/>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Password:</label>
                        <input v-model="registerCustomerDto.password" type="password" class="form-control"/>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Repeat password:</label>
                        <input v-model="registerCustomerDto.repeatPassword" type="password" class="form-control"/>
                    </div>

                    <div class="row">
                        <div class="form-group col">
                            <label class="col-form-label">First name:</label>
                            <input v-model="registerCustomerDto.firstName" type="text" class="form-control"/>
                        </div>
                        <div class="form-group col">
                            <label class="col-form-label">Last name:</label>
                            <input v-model="registerCustomerDto.lastName" type="text" class="form-control"/>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col">
                            <label class="col-form-label">Phone:</label>
                            <input v-model="registerCustomerDto.phone" type="tel" class="form-control" />
                        </div>
                        <div class="form-group col">
                            <label class="col-form-label">Birthdate:</label>
                            <input v-model="registerCustomerDto.birth" type="datetime-local" class="form-control" />
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="col-form-label">Address:</label>
                        <input v-model="registerCustomerDto.address" type="text" class="form-control"/>
                    </div>
                    <div class="row">
                        <div class="form-group col">
                            <label class="col-form-label">City:</label>
                            <input v-model="registerCustomerDto.city" type="text" class="form-control"/>
                        </div>
                        <div class="form-group col">
                            <label class="col-form-label">Postal:</label>
                            <input v-model="registerCustomerDto.postal" type="text" class="form-control"/>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-form-label">Practice:</label>
                        <select class="form-select" name="Practice" v-model="practice.id">
                            <option v-for="practice in practices":value="practice.id">{{practice.name}}</option>
                        </select>
                    </div>
               </form>

            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="hideRegisterForm" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" v-on:click="registerCustomer" class="btn btn-primary">Register</button>
            </div>
        </div>
    </div>
</div>


