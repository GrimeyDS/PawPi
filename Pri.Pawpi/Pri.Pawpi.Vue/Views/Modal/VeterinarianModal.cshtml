<div class="modal fade" id="veterinarianInfo" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">{{veterinarian.firstName}} {{veterinarian.lastName}}</h5>
                <button type="button" v-on:click="hideVeterinarianInfo" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div>
                    <img v-bind:src="veterinarian.imageUrl" v-bind:alt="veterinarian.firstName" id="practiceLogo" onerror="this.onerror=null; this.src='https://cdn4.iconfinder.com/data/icons/forum-buttons-and-community-signs-1/794/profile-3-512.png'" />
                    <h5 class="card-title">{{veterinarian.address}}</h5>
                    <h6>{{veterinarian.postal}} {{veterinarian.city}}</h6>
                    <div class="card-text">
                        <b>Birthdate:</b> {{ veterinarian.birth | formatDate() }}
                        <br />
                        <b>E-mail:</b> {{veterinarian.email}}
                        <br />
                        <b>Phone:</b> {{veterinarian.phone}}
                    </div>
                </div>
                <div class="mt-4">
                    <h5 class="card-title  mb-0">Specialties:</h5>
                    <span v-for="spec in veterinarian.specialties">{{spec.name}}<br /></span>
                    <br/>
                    <h5 class="card-title  mb-0">Practices:</h5>
                    <span v-for="prac in veterinarian.practices">{{prac.name}}<br /></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="hideVeterinarianInfo" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>