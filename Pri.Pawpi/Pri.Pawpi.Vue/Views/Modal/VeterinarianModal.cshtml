<div class="modal fade" id="veterinarianInfo" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">{{veterinarian.firstName}} {{veterinarian.lastName}}</h5>
                <button type="button" v-on:click="hideVeterinarianInfo" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div>
                    <img v-bind:src="veterinarian.imageUrl" v-bind:alt="veterinarian.firstName" id="practiceLogo" onerror="this.onerror=null; this.src='../assets/images/userPlaceHolder.png'" />
                    <h5 class="card-title">{{veterinarian.address}}</h5>
                    <h6>{{veterinarian.postal}} {{veterinarian.city}}</h6>
                    <div class="card-text">
                        <b>Birthdate:</b> {{ veterinarian.birth | formatDate() }}
                        <br />
                        <b>E-mail:</b> {{veterinarian.email}}
                        <br />
                        <b>Phone:</b> {{veterinarian.phone}}
                    </div>
                </div>
                <div class="mt-4">
                    <h5 class="card-title  mb-0">Specialties:</h5>
                    <span v-for="spec in veterinarian.specialties">{{spec.name}}<br /></span>
                    <br/>
                    <h5 class="card-title  mb-0">Practices:</h5>
                    <span v-for="prac in veterinarian.practices">{{prac.name}}<br /></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="showUpdateVeterinarianForm" v-if="isPractice || isVet" class="btn btn-warning">Update</button>
                <button type="button" v-on:click.prevent="deleteVeterinarian(veterinarian.id)" v-if="isPractice" class="btn btn-danger">Delete</button>
                <button type="button" v-on:click="hideVeterinarianInfo" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addVeterinarianForm" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Veterinarian</h5>
                <button type="button" v-on:click="hideVeterinarianForm" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div v-if="hasInputError" class="alert alert-danger m-auto" id="formError">
                    {{errorMessage}}
                </div>
                <form>
                    <div class="row">
                        <div class="form-group col">
                            <label class="col-form-label">First name:</label>
                            <input v-model="veterinarian.firstName" type="text" class="form-control" />
                        </div>
                        <div class="form-group col">
                            <label class="col-form-label">Last name:</label>
                            <input v-model="veterinarian.lastName" type="text" class="form-control" />
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-form-label">E-mail:</label>
                        <input v-model="veterinarian.email" type="email" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="form-group col">
                            <label class="col-form-label">Phone:</label>
                            <input v-model="veterinarian.phone" type="tel" class="form-control" />
                        </div>
                        <div class="form-group col">
                            <label class="col-form-label">Birthday:</label>
                            <input v-model="veterinarian.birth" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-form-label">Address:</label>
                        <input v-model="veterinarian.address" type="text" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="form-group col">
                            <label class="col-form-label">City:</label>
                            <input v-model="veterinarian.city" type="text" class="form-control" />
                        </div>
                        <div class="form-group col">
                            <label class="col-form-label">Postal:</label>
                            <input v-model="veterinarian.postal" type="text" class="form-control" />
                        </div>
                    </div>



                    <div class="form-group">
                        <label class="col-form-label">Practice:</label>
                        <select class="form-select" v-model="veterinarian.practices" multiple>
                            <option v-for="practice in practices" :value="practice.id">
                                {{ practice.name }}
                            </option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Specialty:</label>
                        <select class="form-select" v-model="veterinarian.specialties" multiple>
                            <option v-for="specialty in specialties" :value="specialty.id">
                                {{ specialty.name }}
                            </option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="col-form-label">Picture:</label>
                        <input v-on:change="handleVetFileChange" type="file" class="form-control" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="hideVeterinarianForm" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" v-on:click="addVeterinarian" v-if="!isUpdate" class="btn btn-primary">Add Veterinarian</button>
                <button type="button" v-on:click="updateVeterinarian" v-if="isUpdate" class="btn btn-primary">Update Veterinarian</button>
            </div>
        </div>
    </div>
</div>