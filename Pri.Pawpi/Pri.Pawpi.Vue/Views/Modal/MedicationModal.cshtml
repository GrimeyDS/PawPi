<div class="modal fade" id="medicationInfo" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">{{medication.name}}</h5>
                <button type="button" v-on:click="hideMedicationInfo" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div>
                    <p><b>Note:</b> {{medication.notes}}</p>
                    <p><b>Side Effects:</b> {{medication.sideEffects}}</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click.prevent="deleteMedication(medication.id)" class="btn btn-danger" v-if="isVet">Delete</button>
                <button type="button" v-on:click="hideMedicationInfo" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addMedicationForm" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Add Medication</h5>
                <button type="button" v-on:click="hideMedicationForm" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div v-if="hasInputError" class="alert alert-danger m-auto" id="formError">
                    {{errorMessage}}
                </div>
                <form>
                    <div class="form-group">
                        <label>Name:</label>
                        <input v-model="medication.name" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Notes:</label>
                        <input v-model="medication.notes" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Side effects:</label>
                        <input v-model="medication.sideEffects" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Dosage:</label>
                        <input v-model="medication.dosage" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Frequency:</label>
                        <input v-model="medication.frequency" type="text" class="form-control" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" v-on:click="hideMedicationForm" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" v-on:click="addMedication" class="btn btn-primary">Add Medication</button>
            </div>
        </div>
    </div>
</div>