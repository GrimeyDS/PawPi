<div v-if="petsVisible" class="row">

    <div class="col col-lg-10 m-auto">
        <div class="text-center mb-5" v-if="!isCustomer">
            <input id="searchInput" type="text" v-model="searchName" v-on:keyup="searchPetByName" placeholder="Search by name" />
            <input id="searchInput" type="text" v-model="searchBreed" v-on:keyup="searchPetByBreed" placeholder="Search by breed" />
            <input id="searchInput" type="text" v-model="searchAnimalType" v-on:keyup="searchPetByAnimalType" placeholder="Search by animal type" />
        </div>

        <div class="text-end">
            <a href="#"><img class="crudIcon" src="~/assets/images/add.png" alt="add" v-on:click="showPetForm" v-if="isPractice || isVet" /></a>
        </div>

        <div v-if="searchResults">
            <div v-for="pet in pets" id="card">
                <div class="card" style="width: 18rem;" v-on:click="showPetInfo(pet.id)">
                    <img class="card-img-top" v-bind:src="pet.image" v-bind:alt="pet.name" onerror="this.onerror=null; this.src='../assets/images/petPlaceHolder.png'">
                    <div class="card-body" id="vet-body">
                        <h5 class="card-title">{{pet.name}}</h5>
                        <h6>{{pet.callName}} <br /> </h6>
                        <span>{{pet.animalType}} <br /> </span>
                        <span>{{pet.breed}} <br /> </span>
                    </div>
                </div>
            </div>
        </div>
        <div v-else class="alert alert-secondary m-auto w-50 text-center" id="error">
            Geen resultaten gevonden.
        </div>

        <partial name="../Modal/PetModal.cshtml" />
    </div>
</div>